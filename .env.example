# ==========================================
# IC-Bovi-Scan: Variáveis de Ambiente
# ==========================================

# Configurações do Django
DEBUG=True
SECRET_KEY=django-insecure-change-this-key-in-production-environments

# Hosts permitidos (separados por vírgula)
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de Dados (opcional para PostgreSQL / MySQL)
# Se não definido, o Django utilizará SQLite (db.sqlite3) por padrão
# Exemplo PostgreSQL:
# DATABASE_URL=postgres://usuario:senha@localhost:5432/boviscan_db

# Seguranca e Controle de Acesso
# Por padrao seguro, a autenticacao e obrigatoria (REQUIRE_AUTH_FOR_INFERENCE=True).
# Para permitir acesso anonimo exclusivamente em desenvolvimento local (DEBUG=True), defina como True:
ALLOW_ANONYMOUS_INFERENCE=False
